{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/web.Dockerfile",
    "watchPatterns": ["apps/web/**", "packages/**", "pnpm-lock.yaml", "infrastructure/docker/web.Dockerfile"]
  },
  "deploy": {
    "startCommand": "node /app/web/server.mjs",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
