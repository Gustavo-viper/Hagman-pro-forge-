{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/api.Dockerfile",
    "watchPatterns": ["apps/api/**", "packages/shared/**", "packages/schemas/**", "packages/types/**", "database/**", "pnpm-lock.yaml", "infrastructure/docker/api.Dockerfile"]
  },
  "deploy": {
    "preDeployCommand": ["node /app/database/src/cli.ts deploy"],
    "startCommand": "node /app/api/dist/main.js",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 20,
    "drainingSeconds": 15
  }
}
