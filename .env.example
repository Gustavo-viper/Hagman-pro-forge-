# ============================================================================
# Fandom Universe — environment variables
# Copy to .env for local development:   cp .env.example .env
# NEVER commit .env. In Railway, set these per service (see docs/DEPLOYMENT.md).
# Legend: [api] [worker] [web] = which service reads the variable.
# ============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=development                 # [api][worker] development | test | production
APP_ENV=development                  # [api][worker] development | staging | production
LOG_LEVEL=log                        # [api] error | warn | log | debug | verbose
LOG_JSON=false                       # [api] true in Railway (structured logs)

# --- API ---------------------------------------------------------------------
PORT=3000                            # [api] Railway injects PORT automatically
WEB_ORIGINS=http://localhost:5173    # [api] CORS allow-list, comma separated (exact origins)
RATE_LIMIT_TTL_MS=60000              # [api] rate-limit window
RATE_LIMIT_MAX=120                   # [api] requests per window per IP
SUBSCRIPTION_GRACE_DAYS=3            # [api][worker] grace period for past_due subscriptions
BOOTSTRAP_SUPER_ADMIN_EMAILS=        # [api] verified email(s) that become super_admin on first login,
                                     #       ONLY while no super_admin exists. Leave empty afterwards.

# --- PostgreSQL ---------------------------------------------------------------
# Local:    postgres://fandom:fandom@localhost:5432/fandom
# Railway:  ${{fandom-postgres.DATABASE_URL}}  (private network *.railway.internal → DATABASE_SSL=disable)
DATABASE_URL=postgres://fandom:fandom@localhost:5432/fandom       # [api][worker]
# Optional separate URL for migrations (defaults to DATABASE_URL).
DATABASE_MIGRATION_URL=                                            # [api pre-deploy]
DATABASE_SSL=disable                 # [api][worker] disable | require | verify-full (public/remote hosts: require or verify-full)
DATABASE_CA_CERT=                    # [api][worker] CA certificate (PEM) for verify-full
DATABASE_POOL_MAX=10                 # [api]

# --- Redis (Railway Redis: ${{fandom-redis.REDIS_URL}}) ------------------------
REDIS_URL=redis://localhost:6379     # [api][worker] required in production

# --- Authentication (first-party, no external provider) ----------------------
# Random secret, >= 32 chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars   # [api] SECRET
AUTH_ACCESS_TOKEN_TTL_SECONDS=900    # [api] access token lifetime (15 min)
AUTH_REFRESH_TOKEN_TTL_DAYS=30       # [api] refresh token lifetime (rotates on use)
AUTH_RATE_LIMIT_MAX=10               # [api] requests/min per IP on login, register, reset
EMAIL_VERIFICATION_TTL_HOURS=48      # [api]
PASSWORD_RESET_TTL_MINUTES=60        # [api]
APP_PUBLIC_URL=http://localhost:5173 # [api] fandom-web public URL, used in email links

# --- Email (delivered by the worker) -----------------------------------------
SMTP_URL=                            # [worker] SECRET e.g. smtps://user:pass@smtp.provider.com:465
EMAIL_FROM="Fandom Universe <no-reply@example.com>"   # [worker]

# --- Worker ------------------------------------------------------------------
PENDING_SUBSCRIPTION_TTL_HOURS=48    # [worker] abandoned checkouts expire after this
SUBSCRIPTION_SWEEP_EVERY_MS=900000   # [worker] lifecycle job interval (15 min)
WORKER_CONCURRENCY=5                 # [worker]

# --- Web (PUBLIC — inlined into the browser bundle at build time) -------------
VITE_API_URL=http://localhost:3000             # [web] public URL of fandom-api
VITE_APP_ENV=development                       # [web]

# --- Payments (stage 10 — not used yet) ---------------------------------------
# STRIPE_SECRET_KEY=                 # [api] SECRET
# STRIPE_WEBHOOK_SECRET=             # [api] SECRET
# MERCADOPAGO_ACCESS_TOKEN=          # [api] SECRET
# MERCADOPAGO_WEBHOOK_SECRET=        # [api] SECRET
